[Unit]
Description=Church Network Manager - Web Dashboard
After=network.target

[Service]
Type=simple
User=pi
WorkingDirectory=/home/pi/church-network-manager/raspberry-pi
ExecStart=/home/pi/church-network-manager/raspberry-pi/venv/bin/uvicorn app.main:app --host 0.0.0.0 --port 8000
Restart=on-failure
RestartSec=5

[Install]
WantedBy=multi-user.target
